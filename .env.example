# Copy to .env and fill in. Only the API key belongs in this file.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides (these are the defaults)
# Any vision model works. Measured against the labelled set in bench/, models around
# $0.03-$0.06 per million tokens produce the same verdicts as ones costing 40x more.
# TC_MODEL=google/gemini-3.8-flash
# TC_BASE_URL=https://openrouter.ai/api/v1
# TC_HOST=127.0.0.1
# TC_PORT=8787
# TC_DAILY_LIMIT=40
# TC_ENV_FILE=/path/to/.env
# TC_SIGNING_KEY=/path/to/key.pem
# TC_PROXY=http://127.0.0.1:8888

# Reports keep the submitted photos, and that is not optional: a permalink has to show the picture
# its verdict was reached from. Each is served only while it still hashes to the digest the report
# carries, so the image on the page is provably the one that was analysed.
# TC_PHOTO_BUDGET_MB caps the stored photos (oldest first). Off by default; setting it means a
# report can outlive its pictures, which is a deliberate trade rather than the default.
# TC_PHOTO_BUDGET_MB=2048
